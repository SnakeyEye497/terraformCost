{
  "name": "terraform-cost-calculator",
  "displayName": "Terraform Cost Calculator",
  "description": "Real-time cost estimation for Terraform infrastructure across AWS, GCP, and Azure",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/terraform-cost-calculator"
  },
  "keywords": ["terraform", "cost", "aws", "gcp", "azure", "cloud", "pricing"],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:file"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terraformCost.calculateCosts",
        "title": "Calculate Terraform Costs",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.toggleCostDisplay",
        "title": "Toggle Cost Display",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.refreshCosts",
        "title": "Refresh Cost Estimates",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.toggleTotalCostHeader",
        "title": "Toggle Total Cost Header",
        "category": "Terraform Cost"
      }
    ],
    "configuration": {
      "title": "Terraform Cost Calculator",
      "properties": {
        "terraformCost.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Terraform cost calculation"
        },
        "terraformCost.providers": {
          "type": "array",
          "default": ["aws", "gcp", "azure"],
          "description": "Cloud providers to support",
          "items": {
            "type": "string",
            "enum": ["aws", "gcp", "azure"]
          }
        },
        "terraformCost.currency": {
          "type": "string",
          "default": "USD",
          "description": "Currency for cost display",
          "enum": ["USD", "EUR", "GBP", "JPY"]
        },
        "terraformCost.region": {
          "type": "object",
          "default": {
            "aws": "us-east-1",
            "gcp": "us-central1",
            "azure": "East US"
          },
          "description": "Default regions for each provider"
        },
        "terraformCost.updateInterval": {
          "type": "number",
          "default": 2000,
          "description": "Cost update interval in milliseconds"
        },
        "terraformCost.showInlineDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show cost estimates inline with code"
        },
        "terraformCost.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show total cost in status bar"
        },
        "terraformCost.showTotalCostHeader": {
          "type": "boolean",
          "default": true,
          "description": "Show total infrastructure cost at the top of Terraform files"
        }
      }
    },
    "languages": [
      {
        "id": "terraform",
        "aliases": ["Terraform", "terraform"],
        "extensions": [".tf", ".tfvars"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "hcl2-parser": "^1.0.3",
    "axios": "^1.6.0",
    "debounce": "^1.2.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.36.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
