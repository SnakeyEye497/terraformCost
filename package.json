{
  "name": "terraform-cost-calculator",
  "displayName": "Matali - Terraform Cost Calculator",
  "description": "Real-time cost estimation for Terraform infrastructure across AWS, GCP, and Azure",
  "version": "1.0.0",
  "publisher": "snakeyeye497",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SnakeyEye497/terraformCost.git"
  },
  "bugs": {
    "url": "https://github.com/SnakeyEye497/terraformCost/issues"
  },
  "keywords": [
    "terraform",
    "cost",
    "aws",
    "gcp",
    "azure",
    "cloud",
    "pricing",
    "infracost",
    "finops"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:terraform",
    "workspaceContains:**/*.tf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terraformCost.calculateCosts",
        "title": "Calculate Terraform Costs",
        "category": "Terraform Cost",
        "icon": "$(calculator)"
      },
      {
        "command": "terraformCost.toggleCostDisplay",
        "title": "Toggle Cost Display",
        "category": "Terraform Cost",
        "icon": "$(eye)"
      },
      {
        "command": "terraformCost.refreshCosts",
        "title": "Refresh Cost Estimates",
        "category": "Terraform Cost",
        "icon": "$(refresh)"
      },
      {
        "command": "terraformCost.toggleTotalCostHeader",
        "title": "Toggle Total Cost Header",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.showCostDashboard",
        "title": "Show Cost Dashboard",
        "category": "Terraform Cost",
        "icon": "$(graph)"
      },
      {
        "command": "terraformCost.showWorkspaceCostDashboard",
        "title": "Show Workspace Cost Dashboard",
        "category": "Terraform Cost",
        "icon": "$(graph)"
      },
      {
        "command": "terraformCost.getAiSuggestions",
        "title": "Get AI Cost Optimization Suggestions",
        "category": "Terraform Cost",
        "icon": "$(sparkle)"
      },
      {
        "command": "terraformCost.setAiApiKey",
        "title": "Set AI Provider API Key",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.clearAiApiKey",
        "title": "Clear AI Provider API Key",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.getScalingSuggestions",
        "title": "Get Scaling Suggestions",
        "category": "Terraform Cost",
        "icon": "$(rocket)"
      },
      {
        "command": "terraformCost.setCapacityConfig",
        "title": "Set Capacity & Scaling Inputs",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.exportCostReport",
        "title": "Export Cost Report (Excel)",
        "category": "Terraform Cost",
        "icon": "$(cloud-download)"
      },
      {
        "command": "terraformCost.setBudgetWebhook",
        "title": "Set Budget Alert Webhook (Slack/Teams)",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.testBudgetWebhook",
        "title": "Send Test Budget Alert",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.clearBudgetWebhook",
        "title": "Clear Budget Alert Webhook",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.calculateFromPlan",
        "title": "Calculate Costs from Terraform Plan",
        "category": "Terraform Cost",
        "icon": "$(file-code)"
      },
      {
        "command": "terraformCost.recordCostSnapshot",
        "title": "Record Cost Snapshot",
        "category": "Terraform Cost",
        "icon": "$(history)"
      },
      {
        "command": "terraformCost.compareActualSpend",
        "title": "Compare Estimate with Actual Cloud Spend",
        "category": "Terraform Cost",
        "icon": "$(pulse)"
      },
      {
        "command": "terraformCost.exportErrorLog",
        "title": "Export Error Log",
        "category": "Terraform Cost"
      },
      {
        "command": "terraformCost.clearErrorLog",
        "title": "Clear Error Log",
        "category": "Terraform Cost"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "terraformCost.showCostDashboard",
          "when": "resourceLangId == terraform",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Terraform Cost Calculator",
      "properties": {
        "terraformCost.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Terraform cost calculation"
        },
        "terraformCost.useInfracost": {
          "type": "boolean",
          "default": true,
          "description": "Use Infracost CLI for accurate pricing (requires API key)"
        },
        "terraformCost.infracostApiKey": {
          "type": "string",
          "default": "",
          "description": "Infracost API Key (get free key at https://www.infracost.io)"
        },
        "terraformCost.providers": {
          "type": "array",
          "default": [
            "aws",
            "gcp",
            "azure"
          ],
          "description": "Cloud providers to support",
          "items": {
            "type": "string",
            "enum": [
              "aws",
              "gcp",
              "azure"
            ]
          }
        },
        "terraformCost.currency": {
          "type": "string",
          "default": "USD",
          "description": "Currency for cost display",
          "enum": [
            "USD",
            "EUR",
            "GBP",
            "JPY"
          ]
        },
        "terraformCost.region": {
          "type": "object",
          "default": {
            "aws": "us-east-1",
            "gcp": "us-central1",
            "azure": "eastus"
          },
          "description": "Default regions for each provider"
        },
        "terraformCost.updateInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 10000,
          "description": "Cost update interval in milliseconds"
        },
        "terraformCost.showInlineDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show cost estimates inline with code"
        },
        "terraformCost.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show total cost in status bar"
        },
        "terraformCost.showTotalCostHeader": {
          "type": "boolean",
          "default": true,
          "description": "Show total infrastructure cost at the top of Terraform files"
        },
        "terraformCost.useSeparateBudgetDecoration": {
          "type": "boolean",
          "default": true,
          "description": "Show budget messages as a separate block decoration under the total cost header"
        },
        "terraformCost.expensiveThreshold": {
          "type": "number",
          "default": 100,
          "description": "Monthly cost threshold (in USD) to highlight expensive resources"
        },
        "terraformCost.ai.provider": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "gemini",
            "claude",
            "openai",
            "deepseek",
            "groq"
          ],
          "enumDescriptions": [
            "AI suggestions disabled",
            "Google Gemini",
            "Anthropic Claude",
            "OpenAI GPT",
            "DeepSeek (low-cost, no minimum spend)",
            "Groq (free tier, no card required)"
          ],
          "description": "AI provider used for cost optimization suggestions. Set an API key first via the 'Terraform Cost: Set AI Provider API Key' command — keys are stored securely (VS Code SecretStorage), never in settings."
        },
        "terraformCost.ai.model": {
          "type": "string",
          "default": "",
          "description": "Override the model id used for AI suggestions (e.g. 'gemini-flash-latest', 'claude-sonnet-5', 'gpt-4o-mini'). Leave blank to use the provider's default."
        },
        "terraformCost.notifications.provider": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "slack",
            "teams"
          ],
          "enumDescriptions": [
            "Budget alert webhooks disabled",
            "Slack incoming webhook",
            "Microsoft Teams (Workflows webhook or classic Incoming Webhook)"
          ],
          "description": "Chat platform for budget threshold alerts. Set the webhook URL first via the 'Terraform Cost: Set Budget Alert Webhook' command — stored securely (VS Code SecretStorage), never in settings."
        },
        "terraformCost.billing.awsProfile": {
          "type": "string",
          "default": "",
          "description": "AWS CLI profile used by 'Compare Estimate with Actual Cloud Spend' (Cost Explorer). Leave blank to use the CLI's default credentials."
        },
        "terraformCost.billing.azureSubscriptionId": {
          "type": "string",
          "default": "",
          "description": "Azure subscription id used by 'Compare Estimate with Actual Cloud Spend'. Leave blank to use the `az account show` default subscription."
        },
        "terraformCost.billing.gcpBillingExportTable": {
          "type": "string",
          "default": "",
          "description": "BigQuery table holding your Cloud Billing export (project.dataset.table), used by 'Compare Estimate with Actual Cloud Spend' for Google Cloud."
        }
      }
    },
    "languages": [
      {
        "id": "terraform",
        "aliases": [
          "Terraform",
          "terraform",
          "HCL"
        ],
        "extensions": [
          ".tf",
          ".tfvars"
        ]
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production",
    "vscode:prepublish": "npm run package",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./test/runTest.js",
    "vsix": "vsce package"
  },
  "dependencies": {
    "debounce": "^2.0.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.56.0",
    "mocha": "^12.0.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "galleryBanner": {
    "color": "#3B2A8F",
    "theme": "dark"
  },
  "homepage": "https://github.com/SnakeyEye497/terraformCost#readme",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
