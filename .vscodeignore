# Everything the extension needs at runtime is bundled into dist/ by webpack,
# so sources, tests, docs, and node_modules are left out of the .vsix.
# (README.md, CHANGELOG.md, LICENSE, package.json and images/icon.png ship.)
.vscode/**
.vscode-test/**
.github/**
node_modules/**
src/**
test/**
scripts/**
docs/**
examples/**
images/**
!images/icon.png
webpack.config.js
eslint.config.mjs
jsconfig.json
.gitignore
.yarnrc
**/*.map
**/*.ts
**/.terraform/**
*.vsix
.DS_Store
*.log
coverage/**
